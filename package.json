{
  "name": "gameon-app",
  "version": "1.0.0",
  "description": "**GameOn** is an offline-first Progressive Web App (PWA) designed specifically for grassroots soccer coaches. It runs completely locally in the browser on desktop, tablet, or mobile phone, requiring zero backend server, zero login, and no internet connection during match day.",
  "main": "html2pdf.bundle.min.js",
  "scripts": {
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i ./src/input.css -o ./tailwind.min.css --minify",
    "bundle": "python bundle_offline.py",
    "test": "node test_app.js",
    "test:browser": "node test_browser.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FracturedOrbit1980/GameOn.git"
  },
  "keywords": [],
  "author": "",
