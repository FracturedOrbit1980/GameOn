  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FracturedOrbit1980/GameOn/issues"
  },
  "homepage": "https://github.com/FracturedOrbit1980/GameOn#readme",
  "devDependencies": {
    "playwright": "^1.64.1",
    "tailwindcss": "^3.4.17"
  }
}
